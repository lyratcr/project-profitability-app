// KPI row for the chosen month, over the same people as the list (allocation-people-vars.dax). Over 40 h counts
// whole hours, as the list shows them (under half an hour over reads as none).
EVALUATE
ROW (
    // Counts are 0, not blank, when nobody matches (e.g. one person picked who isn't over 40 h).
    "People", COUNTROWS ( _people ) + 0,
    "Revenue", SUMX ( _people, [MonthRevenue] ),
    "FreeHours", SUMX ( _people, [FreeHours] ),
    "OverPeople", COUNTROWS ( FILTER ( _people, ROUND ( [OverHours], 0 ) > 0 ) ) + 0
)
