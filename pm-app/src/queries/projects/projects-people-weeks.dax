// P6 people x week (PMs, 2026-11-12): per person and Sunday-Saturday week, Synerion hours vs the person's plan
// (Backlog through the Auxis ID), the difference and the variance %; plus each person's total over the window
// (IsWeekTotal = 1). People come from dim_employee: hours through the active ukg_employee_id relationship, plan
// through the inactive employee_number one (inside the measures). Employee names are allowed here by the design.
// Hours (Ion, 2026-11-16): [Matrix Hours_app] = Project Ops billed T&M hours for weeks the integration already
// posted, Synerion for later weeks and for Fixed Fee projects; SynerionHours and BilledVsSynerion feed the tooltip.
EVALUATE
FILTER (
    SUMMARIZECOLUMNS (
        dim_employee[employee_number],
        dim_employee[employee_full_name],
        ROLLUPADDISSUBTOTAL ( dim_calendar[start_of_week_sun], "IsWeekTotal" ),
        /* @filters */
        "Hours", [Matrix Hours_app],
        "PlannedHours", [Planned Hours by Person_app],
        "Diff", [Matrix Hours vs Plan by Person_app],
        "Variance", [Matrix Hours vs Plan Variance % by Person_app],
        "SynerionHours", [Synerion Hours_app],
        "BilledVsSynerion", IF ( NOT ISBLANK ( [Synerion Hours_app] ) || NOT ISBLANK ( [Matrix Hours_app] ), [Matrix Hours_app] - [Synerion Hours_app] ),
        "FromProjectOps",
            IF (
                ISINSCOPE ( dim_calendar[start_of_week_sun] )
                    && MAX ( dim_calendar[start_of_week_sun] ) <= [Last Revenue Date_app]
                    && ISEMPTY ( CALCULATETABLE ( fact_revenue_metrics, REMOVEFILTERS ( dim_calendar ), REMOVEFILTERS ( dim_employee ), fact_revenue_metrics[scenario] = "Backlog", fact_revenue_metrics[revenue_type] = "Fixed Fee" ) )
                    && ( NOT ISBLANK ( [Matrix Hours_app] ) || NOT ISBLANK ( [Synerion Hours_app] ) ),
                1
            )
    ),
    NOT ISBLANK ( dim_employee[employee_number] )
)
ORDER BY dim_employee[employee_full_name], dim_employee[employee_number], [IsWeekTotal], dim_calendar[start_of_week_sun]
