	measure 'Validation Window Hours' = ```
			
			VAR _today = TODAY()
			VAR _dayOfWeek = WEEKDAY(_today, 2) -- 1=Mon, 2=Tue... 7=Sun
			VAR _isMonday = _dayOfWeek = 1
			
			-- Si es Lunes: mostrar semana pasada (Lun-Dom anterior)
			-- Si es Mar-Dom: mostrar semana en curso (Lun de esta semana hasta hoy)
			VAR _weekStart = 
			    IF(
			        _isMonday,
			        _today - 7, -- Lunes de la semana pasada
			        _today - _dayOfWeek + 1 -- Lunes de esta semana
			    )
			VAR _weekEnd = 
			    IF(
			        _isMonday,
			        _today - 1, -- Domingo pasado
			        _today -- Hasta hoy
			    )
			RETURN
			CALCULATE(
			    [Total Worked Hours],
			    'dim_calendar'[date] >= _weekStart,
			    'dim_calendar'[date] <= _weekEnd
			)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: New
		lineageTag: 03d20d4e-7c03-4a00-95bd-f096c729939a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Validation Window Label' = ```
			
			VAR _today = TODAY()
			VAR _dayOfWeek = WEEKDAY(_today, 2)
			VAR _isMonday = _dayOfWeek = 1
			VAR _weekStart = 
			    IF(
			        _isMonday,
			        _today - 7,
			        _today - _dayOfWeek + 1
			    )
			VAR _weekEnd = 
			    IF(
			        _isMonday,
			        _today - 1,
			        _today
			    )
			VAR _label =
			    IF(
			        _isMonday,
			        "Last Week: " & FORMAT(_weekStart, "MMM DD") & " - " & FORMAT(_weekEnd, "MMM DD"),
			        "Current Week: " & FORMAT(_weekStart, "MMM DD") & " - " & FORMAT(_weekEnd, "MMM DD")
			    )
			RETURN _label
			```
		displayFolder: New
		lineageTag: 3c2f96e7-6d6c-4bdb-b6e5-e36805e5cc50

