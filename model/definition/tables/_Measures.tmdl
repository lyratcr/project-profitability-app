	measure 'Operational FTE % (Last Week)' = ```
			
			// 1. Identify the latest transaction date and its corresponding Year-Week.
			VAR MaxFactDate = MAX('fact_profitability_metrics'[transaction_date])
			
			VAR TargetYearWeek = 
			    CALCULATE(
			        MAX('dim_calendar'[year_week]),
			        'dim_calendar'[date] = MaxFactDate,
			        REMOVEFILTERS('dim_calendar')
			    )
			
			// 2. Iterate over each unique employee to calculate their proportional FTE.
			VAR CalculateProportionalFTE = 
			    SUMX(
			        VALUES('fact_profitability_metrics'[ukg_employee_id]),
			        
			        VAR CurrentEmployee = 'fact_profitability_metrics'[ukg_employee_id]
			        
			        // 3. Hours worked by the employee in the specific project/segment for the target week.
			        VAR ContextHours = 
			            CALCULATE(
			                SUM('fact_profitability_metrics'[worked_hours]),
			                REMOVEFILTERS('dim_calendar'),
			                'dim_calendar'[year_week] = TargetYearWeek
			            )
			            
			        // 4. Total hours worked by the employee across ALL projects and departments for the target week.
			        // REMOVEFILTERS on dimensions ensures we capture the employee's true 100% capacity as the denominator.
			        VAR TotalWeekHours = 
			            CALCULATE(
			                SUM('fact_profitability_metrics'[worked_hours]),
			                REMOVEFILTERS('dim_project'),
			                REMOVEFILTERS('dim_Hierarchy_Master'),
			                REMOVEFILTERS('fact_profitability_metrics'),
			                'fact_profitability_metrics'[ukg_employee_id] = CurrentEmployee,
			                REMOVEFILTERS('dim_calendar'),
			                'dim_calendar'[year_week] = TargetYearWeek
			            )
			            
			        RETURN
			            // Al retornar BLANK(), Power BI ocultará automáticamente los proyectos sin horas.
			            DIVIDE(ContextHours, TotalWeekHours, BLANK())
			    )
			
			// 5. Apply the virtual relationship for the Master Hierarchy if active in the visual context.
			RETURN
			    IF(
			        ISFILTERED('dim_Hierarchy_Master'[L1]) || ISFILTERED('dim_Hierarchy_Master'[L2]) || ISFILTERED('dim_Hierarchy_Master'[L3]),
			        CALCULATE(
			            CalculateProportionalFTE,
			            TREATAS(
			                SUMMARIZE('dim_Hierarchy_Master', 'dim_Hierarchy_Master'[L1], 'dim_Hierarchy_Master'[L2], 'dim_Hierarchy_Master'[L3]),
			                'fact_profitability_metrics'[employee_L1],
			                'fact_profitability_metrics'[employee_L2],
			                'fact_profitability_metrics'[employee_L3]
			            )
			        ),
			        CalculateProportionalFTE
			    )
			```
		formatString: 0%;-0%;0%
		displayFolder: FTE
		lineageTag: 309e8ac3-58a2-43e8-be03-78bdf90faf91

