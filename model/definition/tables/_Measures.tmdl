	measure 'LTD Backlog' = ```
			
			// Calculates the Life-to-Date (LTD) actual revenue.
			// REMOVEFILTERS ignores page-level date slicers (e.g., 'This Week') 
			// to ensure the full historical amount is captured.
			CALCULATE(
			    SUM(fact_revenue_metrics[actual_revenue_usd]),
			    fact_revenue_metrics[scenario] = "Backlog",
			    REMOVEFILTERS('dim_calendar')
			)
