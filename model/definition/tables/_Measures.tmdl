	measure 'Operational FTE (Last Week) LIGHT' = ```
			
			// 1. Identify the latest transaction date and its corresponding Year-Week to establish the current reporting period.
			VAR MaxFactDate = MAX('fact_profitability_metrics'[transaction_date])
			
			VAR TargetYearWeek = 
			    CALCULATE(
			        MAX('dim_calendar'[year_week]),
			        'dim_calendar'[date] = MaxFactDate,
			        REMOVEFILTERS('dim_calendar')
			    )
			
			RETURN
			    // 2. Iterate over each unique employee to accurately calculate their individual proportional FTE.
			    SUMX(
			        VALUES('fact_profitability_metrics'[ukg_employee_id]),
			        
			        VAR CurrentEmployee = 'fact_profitability_metrics'[ukg_employee_id]
			        
			        // 3. Calculate the hours logged by the employee strictly within the current visual context (Project) for the target week.
			        VAR ContextHours = 
			            CALCULATE(
			                SUM('fact_profitability_metrics'[worked_hours]),
			                REMOVEFILTERS('dim_calendar'),
			                'dim_calendar'[year_week] = TargetYearWeek
			            )
			            
			        // 4. Calculate the total baseline hours worked by the employee across ALL projects for the target week.
			        // REMOVEFILTERS on the project dimension ensures we capture the employee's true 100% weekly capacity as the denominator.
			        VAR TotalWeekHours = 
			            CALCULATE(
			                SUM('fact_profitability_metrics'[worked_hours]),
			                REMOVEFILTERS('dim_project'),
			                REMOVEFILTERS('fact_profitability_metrics'),
			                'fact_profitability_metrics'[ukg_employee_id] = CurrentEmployee,
			                REMOVEFILTERS('dim_calendar'),
			                'dim_calendar'[year_week] = TargetYearWeek
			            )
			            
			        RETURN
			            // 5. Compute the proportional FTE. Returning BLANK() instead of 0 ensures empty rows are automatically hidden in the matrix visual.
			            DIVIDE(ContextHours, TotalWeekHours, BLANK())
			    )
			```
