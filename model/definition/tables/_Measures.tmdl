	measure 'SVG FTE MoM %' =
			
			VAR _CM = [Operational FTE (Last Week)]
			VAR _LM = CALCULATE([Operational FTE (Last Week)], DATEADD('dim_calendar'[date], -1, MONTH))
			VAR _perc = DIVIDE(_CM - _LM, _LM, 0)
			VAR _percText = FORMAT(ABS(_perc), "0.0%")
			VAR _color = SWITCH(TRUE(), _perc > 0, "#729b78", _perc < 0, "#9E2B2B", "#5a5457")
			VAR _arrow = SWITCH(
			    TRUE(),
			    _perc > 0, "<polygon points='10,2 2,14 18,14' fill='" & _color & "'/>",
			    _perc < 0, "<polygon points='2,2 18,2 10,14' fill='" & _color & "'/>",
			    "<rect x='2' y='7' width='16' height='3' rx='1.5' fill='" & _color & "'/>"
			)
			VAR _sign = IF(_perc > 0, "+", IF(_perc < 0, "-", ""))
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 20' width='140' height='40'>" &
			"<g transform='translate(0,3)'>" & _arrow & "</g>" &
			"<text x='24' y='14' font-family='sans-serif' font-size='12' font-weight='500' fill='" & _color & "'>" &
			_sign & _percText &
			"</text>" &
			"</svg>"
		displayFolder: New
		lineageTag: b8762cc5-a04a-4bb1-9dad-c087d8c6ace0
		dataCategory: ImageUrl

	measure 'SVG Project End Date' = ```
			
			-- ============================================
			-- CONFIGURACION DE TAMAÑO - Ajusta aqui
			VAR _svgWidth = 129
			VAR _svgHeight = 40
			VAR _fontSize = 16
			VAR _circleR = 10
			VAR _circleX = 12
			VAR _circleY = 15
			VAR _textX = 30
			VAR _textY = 23
			-- ============================================
			
			VAR _endDate = [Project End Date]
			VAR _daysLeft = DATEDIFF(TODAY(), _endDate, DAY)
			VAR _color = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(_endDate), "#5a5457",
			        _daysLeft < 0, "#9E2B2B",
			        _daysLeft <= 30, "#9E2B2B",
			        _daysLeft <= 90, "#C4843A",
			        "#729b78"
			    )
			VAR _label = 
			    SWITCH(
			        TRUE(),
			        ISBLANK(_endDate), "No backlog",
			        _daysLeft < 0, "Vencido",
			        _daysLeft <= 30, "< 30 dias",
			        _daysLeft <= 90, "< 90 dias",
			        FORMAT(_endDate, "MMM DD, YYYY")
			    )
			RETURN
			"data:image/svg+xml;utf8," &
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & _svgWidth & " " & _svgHeight & "' width='" & _svgWidth & "' height='" & _svgHeight & "'>" &
			"<circle cx='" & _circleX & "' cy='" & _circleY & "' r='" & _circleR & "' fill='" & _color & "'/>" &
			"<text x='" & _textX & "' y='" & _textY & "' font-family='sans-serif' font-size='" & _fontSize & "' font-weight='500' fill='" & _color & "'>" &
			_label &
			"</text>" &
			"</svg>"
			```
		displayFolder: New
		lineageTag: 6279c5fa-d388-4624-a956-0b873fa85bbf
		dataCategory: ImageUrl

