	measure 'FTE Time Allocation %' = ```
			
			// 1. Calculate hours logged by the employee strictly within the current visual context 
			// (e.g., specific Project, Customer, or L3 department).
			VAR ContextHours = SUM('fact_profitability_metrics'[worked_hours])
			
			// 2. Calculate the total hours logged by the same employee across the entire filtered period.
			// REMOVEFILTERS is used to bypass structural project and organizational hierarchy constraints,
			// ensuring the denominator captures the true 100% of the employee's effort for the selected timeframe.
			VAR TotalEmployeeHours = 
			    CALCULATE(
			        SUM('fact_profitability_metrics'[worked_hours]),
			        REMOVEFILTERS('dim_project'),
			        REMOVEFILTERS('dim_Hierarchy_Master')
			    )
			
			RETURN
			    // 3. Compute the fractional time allocation for the current row.
			    DIVIDE(ContextHours, TotalEmployeeHours, 0)
			```
		formatString: 0%;-0%;0%
		lineageTag: 3d40521b-0141-4d96-8cc5-8eea52ebca12

	measure 'Annualized Revenue per FTE' = ```
			
			VAR MonthlyRevenuePerFTE = 
			    DIVIDE(
			        [Total Revenue (Master Hierarchy)], 
			        [Operational FTE (Last Week)], 
