	measure 'Operational Headcount (Last Week)' = ```
			
			// 1. Retrieve the latest transaction date currently visible in the fact table. 
			// This automatically handles both filtered (specific month) and unfiltered (all-time) states perfectly.
			VAR MaxFactDate = MAX('fact_profitability_metrics'[transaction_date])
			
			// 2. Identify the unique Year-Week identifier (e.g., "2026 W04") for that specific max date.
			VAR TargetYearWeek = 
			    CALCULATE(
			        MAX('dim_calendar'[year_week]),
			        'dim_calendar'[date] = MaxFactDate,
			        REMOVEFILTERS('dim_calendar')
			    )
			
			RETURN
			// 3. Calculate distinct headcount overriding the calendar filter, now supporting L1, L2, and L3 filtering.
			IF(
			    ISFILTERED('dim_Hierarchy_Master'[L1]) || ISFILTERED('dim_Hierarchy_Master'[L2]) || ISFILTERED('dim_Hierarchy_Master'[L3]),
			    CALCULATE(
			        DISTINCTCOUNT('fact_profitability_metrics'[ukg_employee_id]),
			        REMOVEFILTERS('dim_calendar'),
			        'dim_calendar'[year_week] = TargetYearWeek,
			        TREATAS(
			            SUMMARIZE('dim_Hierarchy_Master', 'dim_Hierarchy_Master'[L1], 'dim_Hierarchy_Master'[L2], 'dim_Hierarchy_Master'[L3]),
			            'fact_profitability_metrics'[employee_L1],
			            'fact_profitability_metrics'[employee_L2],
			            'fact_profitability_metrics'[employee_L3]
			        )
			    ),
			    CALCULATE(
			        DISTINCTCOUNT('fact_profitability_metrics'[ukg_employee_id]),
			        REMOVEFILTERS('dim_calendar'),
			        'dim_calendar'[year_week] = TargetYearWeek
			    )
			)
			```
		formatString: #,0
		lineageTag: 5b22cfc7-aa33-4725-ac7a-098d4d1e0f67

