	/// ADDED 2026-11-04 (Fabric app): Revenue per FTE x 12. Valid for a single month only.
	/// FIXED 2026-11-05 (Fabric app): Adan's Annualized Revenue per FTE (monthly revenue per FTE × 12) on the Sunday–Saturday week and, with an org filter, the project org's FTE. Valid for a single month only.
	measure 'Annualized Revenue per FTE_app' = DIVIDE ( [Actual Revenue_app], [Allocated FTE (Last Week, Project Org)_app], BLANK () ) * 12
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Yield
		lineageTag: 5573c208-fd0b-4614-890c-2c4ced5fc929

	/// ADDED 2026-11-04 (Fabric app): Actual revenue / headcount (last week). Monthly context only.
	measure 'Revenue per Head_app' = [Revenue per Headcount]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Yield
		lineageTag: b1c7fc84-c0e8-4f9b-bfc3-6a00745c1996

	/// ADDED 2026-11-04 (Fabric app): Change in revenue per FTE vs one month earlier (numeric).
	measure 'Revenue per FTE MoM %_app' =
			VAR _lm = CALCULATE ( [Revenue per FTE_app], DATEADD ( dim_calendar[date], -1, MONTH ) )
			RETURN DIVIDE ( [Revenue per FTE_app] - _lm, _lm )
		formatString: 0.0%
		displayFolder: _app\Yield
		lineageTag: 0db3fccd-8656-44f2-b7aa-3c8fd5653668

	/// ADDED 2026-11-04 (Fabric app): Actual revenue over the project's life (ignores the date filter).
	measure 'Revenue Billed to Date_app' = [LTD Actual Revenue]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Projects
		lineageTag: 698d15c7-39f3-4a52-8b3e-03859550be65

	/// ADDED 2026-11-04 (Fabric app): Whole plan (Backlog scenario, all dates).
	measure 'Total Planned Revenue_app' = [LTD Backlog]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Projects
		lineageTag: 2cbd579c-5043-43fe-bfda-09b9590bce0a

	/// ADDED 2026-11-04 (Fabric app): Plan minus billed to date.
	measure 'Revenue Left to Bill_app' = [Remaining Backlog]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Projects
		lineageTag: a5e65791-fd96-49c2-83e0-e3280d6b27ca

	/// ADDED 2026-11-04 (Fabric app): Billed to date / total plan.
	measure 'Billing Progress %_app' = [Project Progress %]
		formatString: 0.0%
		displayFolder: _app\Projects
		lineageTag: 8ae4a9c6-5f35-4ec9-adc4-65cab3235319

	/// ADDED 2026-11-04 (Fabric app): Last date in the plan (Backlog), whole project life. Unlike the original, it ignores the date filter.
	measure 'Plan End Date_app' = CALCULATE ( [Project End Date], REMOVEFILTERS ( 'dim_calendar' ) )
		formatString: yyyy-mm-dd
		displayFolder: _app\Projects
		lineageTag: c5c3ea8e-9a93-42cc-90ad-e79a0eb2d7a7

	/// ADDED 2026-11-04 (Fabric app): Plan (Backlog) revenue in the selected period. FIXED 2026-11-04 (Fabric app): follows the master hierarchy through the financial org.
	measure 'Planned Revenue_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        CALCULATE ( SUM ( fact_revenue_metrics[actual_revenue_usd] ), fact_revenue_metrics[scenario] = "Backlog" ),
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_revenue_metrics[financial_L1], fact_revenue_metrics[financial_L2], fact_revenue_metrics[financial_L3]
			        )
			    ),
			    CALCULATE ( SUM ( fact_revenue_metrics[actual_revenue_usd] ), fact_revenue_metrics[scenario] = "Backlog" )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Projects
		lineageTag: 8d7499e1-d1a4-46d2-91c3-5d1b9c7d1d0f

	/// ADDED 2026-11-04 (Fabric app): Plan (Backlog) hours in the selected period. FIXED 2026-11-04 (Fabric app): follows the master hierarchy through the financial org.
	measure 'Planned Hours_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        CALCULATE ( SUM ( fact_revenue_metrics[hours_quantity] ), fact_revenue_metrics[scenario] = "Backlog" ),
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_revenue_metrics[financial_L1], fact_revenue_metrics[financial_L2], fact_revenue_metrics[financial_L3]
			        )
			    ),
			    CALCULATE ( SUM ( fact_revenue_metrics[hours_quantity] ), fact_revenue_metrics[scenario] = "Backlog" )
			)
		formatString: #,0
		displayFolder: _app\Projects
		lineageTag: 5ee51671-206b-40cf-8c8e-ab6482001937

	/// ADDED 2026-11-04 (Fabric app): Hours integrated into Project Operations (Actual) in the period. FIXED 2026-11-04 (Fabric app): follows the master hierarchy through the financial org.
	measure 'Billed Hours_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        CALCULATE ( SUM ( fact_revenue_metrics[hours_quantity] ), fact_revenue_metrics[scenario] = "Actual" ),
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_revenue_metrics[financial_L1], fact_revenue_metrics[financial_L2], fact_revenue_metrics[financial_L3]
			        )
			    ),
			    CALCULATE ( SUM ( fact_revenue_metrics[hours_quantity] ), fact_revenue_metrics[scenario] = "Actual" )
			)
		formatString: #,0
		displayFolder: _app\Projects
		lineageTag: bb6aae7e-1ae0-41f7-81b1-f54f1e97dfed

	/// ADDED 2026-11-04 (Fabric app): Actual minus planned revenue. Monthly or longer periods only.
	measure 'Revenue vs Plan_app' = [Actual Revenue_app] - [Planned Revenue_app]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: _app\Projects
		lineageTag: 657483db-2c52-42ab-a0f4-e0dd757849d7

	/// ADDED 2026-11-04 (Fabric app): Actual / planned revenue. Monthly or longer periods only.
	measure 'Revenue vs Plan %_app' = DIVIDE ( [Actual Revenue_app], [Planned Revenue_app] )
		formatString: 0.0%
		displayFolder: _app\Projects
		lineageTag: 2e215692-3dfe-499b-a99b-5e04634c6130

	/// FIXED 2026-11-06 (Fabric app): Synerion minus planned hours; blank when the period has no plan hours. Project level only.
	measure 'Hours vs Plan_app' = IF ( NOT ISBLANK ( [Planned Hours_app] ), [Synerion Hours_app] - [Planned Hours_app] )
		formatString: #,0;-#,0;0
		displayFolder: _app\Projects
		lineageTag: d3a499be-fdd8-4038-90d0-0f48f37eb8f3

	/// ADDED 2026-11-04 (Fabric app): Synerion / planned hours. Project level only; blank without plan hours.
	measure 'Hours vs Plan %_app' = DIVIDE ( [Synerion Hours_app], [Planned Hours_app] )
		formatString: 0.0%
		displayFolder: _app\Projects
		lineageTag: d8d1c450-ce90-4cc4-82dd-312688486347

	/// ADDED 2026-11-04 (Fabric app): Hours in Synerion not yet integrated into Project Operations.
	measure 'Hours Not Yet Billed_app' = [Synerion Hours_app] - [Billed Hours_app]
		formatString: #,0;-#,0;0
		displayFolder: _app\Projects
		lineageTag: e2971c0c-a547-47eb-866e-a1a304ed0dc7

	/// ADDED 2026-11-04 (Fabric app): Last day with Synerion hours loaded.
	measure 'Last Synerion Date_app' = CALCULATE ( MAX ( fact_profitability_metrics[transaction_date] ), REMOVEFILTERS () )
		formatString: yyyy-mm-dd
		displayFolder: _app\Data health
		lineageTag: 31cf5317-146c-45d3-95df-0572f5d9f14e

	/// ADDED 2026-11-04 (Fabric app): Last day with T&M actuals (follows the hours integration); other revenue types are posted with future dates.
	measure 'Last Revenue Date_app' =
			CALCULATE (
			    MAX ( fact_revenue_metrics[transaction_date] ),
			    fact_revenue_metrics[scenario] = "Actual",
			    fact_revenue_metrics[revenue_type] = "T&M",
			    REMOVEFILTERS ()
			)
		formatString: yyyy-mm-dd
		displayFolder: _app\Data health
		lineageTag: feea6d63-5170-4141-872f-4ae048c2ea01

	/// ADDED 2026-11-04 (Fabric app): Synerion hours in the 28 days before the first date of the selected period (the 4 weeks before the selected week).
	measure 'Hours Previous 4 Weeks_app' =
			VAR _start = MIN ( dim_calendar[date] )
			RETURN
			    CALCULATE (
			        [Synerion Hours_app],
			        REMOVEFILTERS ( dim_calendar ),
			        DATESBETWEEN ( dim_calendar[date], _start - 28, _start - 1 )
			    )
		formatString: #,0
		displayFolder: _app\Projects
		lineageTag: caeef1fa-38d0-4461-8084-1a1b50cc01a8

	/// ADDED 2026-11-04 (Fabric app): 1 when there are hours in the previous 4 weeks but none in the selected period; blank otherwise. Use per person and project.
	measure 'Missing This Week_app' = IF ( [Hours Previous 4 Weeks_app] > 0 && COALESCE ( [Synerion Hours_app], 0 ) = 0, 1 )
		formatString: 0
		displayFolder: _app\Projects
		lineageTag: 066350ab-2bcb-48f2-957d-510cd43453e4

	/// ADDED 2026-11-04 (Fabric app): Synerion hours of the people who sit in the selected org (employee org).
	measure 'Synerion Hours (Employee Org)_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        [Total Worked Hours],
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_profitability_metrics[employee_L1], fact_profitability_metrics[employee_L2], fact_profitability_metrics[employee_L3]
			        )
			    ),
			    [Total Worked Hours]
			)
		formatString: #,0
		displayFolder: _app\Hours
		lineageTag: a20e4bc6-8d60-454f-a332-25c4854dc283

	/// ADDED 2026-11-04 (Fabric app): Synerion hours logged on projects that belong to the selected org (project org).
	measure 'Synerion Hours (Project Org)_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        [Total Worked Hours],
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_profitability_metrics[project_L1], fact_profitability_metrics[project_L2], fact_profitability_metrics[project_L3]
			        )
			    ),
			    [Total Worked Hours]
			)
		formatString: #,0
		displayFolder: _app\Hours
		lineageTag: b7282b1e-1f03-4b3d-9473-c7c7e7baa7d2

	/// ADDED 2026-11-04 (Fabric app): People with hours who sit in the selected org.
	measure 'People With Hours (Employee Org)_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        [Active Headcount],
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_profitability_metrics[employee_L1], fact_profitability_metrics[employee_L2], fact_profitability_metrics[employee_L3]
			        )
			    ),
			    [Active Headcount]
			)
		formatString: #,0
		displayFolder: _app\People
		lineageTag: 34d7a268-8b32-4cd9-a677-f5d485806d13

	/// ADDED 2026-11-04 (Fabric app): People with hours on the selected org's projects.
	measure 'People With Hours (Project Org)_app' =
			IF (
			    ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			    CALCULATE (
			        [Active Headcount],
			        TREATAS (
			            SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			            fact_profitability_metrics[project_L1], fact_profitability_metrics[project_L2], fact_profitability_metrics[project_L3]
			        )
			    ),
			    [Active Headcount]
			)
		formatString: #,0
		displayFolder: _app\People
		lineageTag: ac3e2591-ab6b-4f15-b9a2-163d630e5bfd

	/// ADDED 2026-11-04 (Fabric app): Change in employee-org Synerion hours vs the same period one month earlier (numeric); follows the master hierarchy.
	measure 'Synerion Hours (Employee Org) MoM %_app' =
			VAR _lm = CALCULATE ( [Synerion Hours (Employee Org)_app], DATEADD ( dim_calendar[date], -1, MONTH ) )
			RETURN DIVIDE ( [Synerion Hours (Employee Org)_app] - _lm, _lm )
		formatString: 0.0%
		displayFolder: _app\Hours
		lineageTag: d5748371-1620-4adc-b675-8df293a113a0

	/// ADDED 2026-11-04 (Fabric app): Change in project-org Synerion hours vs the same period one month earlier (numeric); follows the master hierarchy.
	measure 'Synerion Hours (Project Org) MoM %_app' =
			VAR _lm = CALCULATE ( [Synerion Hours (Project Org)_app], DATEADD ( dim_calendar[date], -1, MONTH ) )
			RETURN DIVIDE ( [Synerion Hours (Project Org)_app] - _lm, _lm )
		formatString: 0.0%
		displayFolder: _app\Hours
		lineageTag: 5aed62ab-f0a4-4912-bc35-a1d598f89bb5

	/// ADDED 2026-11-04 (Fabric app): Share of employee-org Synerion hours that are productive: subtask Regular Time, Activity 01/02 or Productive Time, excluding Holiday and Time Off pay.
	measure 'Productive Share (Employee Org)_app' =
			DIVIDE (
			    CALCULATE (
			        [Synerion Hours (Employee Org)_app],
			        KEEPFILTERS ( fact_profitability_metrics[subtask_category] IN { "Regular Time", "Activity 01", "Activity 02", "Productive Time" } ),
			        KEEPFILTERS ( NOT fact_profitability_metrics[pay_category_description] IN { "Holiday", "Time Off" } )
			    ),
			    [Synerion Hours (Employee Org)_app]
			)
		formatString: 0.0%
		displayFolder: _app\Hours
		lineageTag: 9b44ff03-c7cb-429f-95e9-7bc3c0830857

	/// ADDED 2026-11-04 (Fabric app): Share of project-org Synerion hours that are productive: subtask Regular Time, Activity 01/02 or Productive Time, excluding Holiday and Time Off pay.
	measure 'Productive Share (Project Org)_app' =
			DIVIDE (
			    CALCULATE (
			        [Synerion Hours (Project Org)_app],
			        KEEPFILTERS ( fact_profitability_metrics[subtask_category] IN { "Regular Time", "Activity 01", "Activity 02", "Productive Time" } ),
			        KEEPFILTERS ( NOT fact_profitability_metrics[pay_category_description] IN { "Holiday", "Time Off" } )
			    ),
			    [Synerion Hours (Project Org)_app]
			)
		formatString: 0.0%
		displayFolder: _app\Hours
		lineageTag: cac49a04-13fd-442f-b17c-b915f324d77b

	/// ADDED 2026-11-04 (Fabric app): Change in last-week headcount vs the same period one month earlier (numeric).
	measure 'Headcount (Last Week) MoM %_app' =
			VAR _lm = CALCULATE ( [Headcount (Last Week)_app], DATEADD ( dim_calendar[date], -1, MONTH ) )
			RETURN DIVIDE ( [Headcount (Last Week)_app] - _lm, _lm )
		formatString: 0.0%
		displayFolder: _app\People
		lineageTag: 04acb14a-0388-4d60-a9ac-4a8a71130741

	/// ADDED 2026-11-05 (Fabric app): Allocation FTE in the last Sunday–Saturday week with hours, mapping the master hierarchy to the project org: the share of people's time on the selected org's projects. Without an org filter it equals Allocated FTE (Last Week)_app.
	measure 'Allocated FTE (Last Week, Project Org)_app' =
			VAR _last = CALCULATE ( MAX ( fact_profitability_metrics[transaction_date] ), ALLEXCEPT ( fact_profitability_metrics, dim_calendar ) )
			VAR _start = _last - WEEKDAY ( _last, 1 ) + 1
			RETURN
			    IF (
			        ISFILTERED ( dim_hierarchy_master[L1] ) || ISFILTERED ( dim_hierarchy_master[L2] ) || ISFILTERED ( dim_hierarchy_master[L3] ),
			        CALCULATE (
			            SUMX (
			                CALCULATETABLE ( VALUES ( fact_profitability_metrics[ukg_employee_id] ), REMOVEFILTERS ( dim_calendar ), DATESBETWEEN ( dim_calendar[date], _start, _start + 6 ) ),
			                VAR _emp = fact_profitability_metrics[ukg_employee_id]
			                VAR _ctx = CALCULATE ( SUM ( fact_profitability_metrics[worked_hours] ), REMOVEFILTERS ( dim_calendar ), DATESBETWEEN ( dim_calendar[date], _start, _start + 6 ) )
			                VAR _tot = CALCULATE ( SUM ( fact_profitability_metrics[worked_hours] ), REMOVEFILTERS ( fact_profitability_metrics ), fact_profitability_metrics[ukg_employee_id] = _emp, DATESBETWEEN ( dim_calendar[date], _start, _start + 6 ) )
			                RETURN DIVIDE ( _ctx, _tot )
			            ),
			            TREATAS (
			                SUMMARIZE ( dim_hierarchy_master, dim_hierarchy_master[L1], dim_hierarchy_master[L2], dim_hierarchy_master[L3] ),
			                fact_profitability_metrics[project_L1], fact_profitability_metrics[project_L2], fact_profitability_metrics[project_L3]
			            )
			        ),
			        [Allocated FTE (Last Week)_app]
			    )
		formatString: #,0.0
		displayFolder: _app\People
		lineageTag: 07ecac4f-6d26-4d50-a521-0ece2664c490

	/// FIXED 2026-11-07 (Fabric app): (Synerion hours - plan hours) / plan hours; +100% when there are hours but no plan hours; blank with neither. Project level only.
	measure 'Hours vs Plan Variance %_app' =
			VAR _hours = [Synerion Hours_app]
			VAR _plan = [Planned Hours_app]
			RETURN
			    IF (
			        NOT ISBLANK ( _plan ) && _plan <> 0,
			        DIVIDE ( _hours - _plan, _plan ),
			        IF ( _hours > 0, 1 )
			    )
		formatString: +0%;-0%;0%
		displayFolder: _app\Projects
		lineageTag: e9a3e781-d3b7-4dae-9b23-cc3f90331c8e

	/// ADDED 2026-11-12 (Fabric app): Plan (Backlog) left to bill as a share of the whole plan (SOW). Whole project life.
	measure 'Revenue Left to Bill %_app' = DIVIDE ( [Revenue Left to Bill_app], [Total Planned Revenue_app] )
		formatString: 0.0%
		displayFolder: _app\Projects
		lineageTag: b8094872-0472-4659-8766-c706f05da75f

	/// ADDED 2026-11-12 (Fabric app): Plan (Backlog) hours of the person in context, through the inactive Auxis ID relationship fact_revenue_metrics[employee_number] -> dim_employee[employee_number].
	measure 'Planned Hours by Person_app' = CALCULATE ( [Planned Hours_app], USERELATIONSHIP ( fact_revenue_metrics[employee_number], dim_employee[employee_number] ) )
		formatString: #,0
		displayFolder: _app\Projects
		lineageTag: c8d0b478-b70f-4a34-a6c4-2a799c0678cf

	/// ADDED 2026-11-12 (Fabric app): Synerion hours minus planned hours of the person; a missing side counts as 0 (unplanned hours are positive, planned but not logged negative).
	measure 'Hours vs Plan by Person_app' =
			VAR _hours = [Synerion Hours_app]
			VAR _plan = [Planned Hours by Person_app]
			RETURN IF ( NOT ISBLANK ( _hours ) || NOT ISBLANK ( _plan ), COALESCE ( _hours, 0 ) - COALESCE ( _plan, 0 ) )
		formatString: #,0;-#,0;0
		displayFolder: _app\Projects
		lineageTag: 5ec4fbd3-0a90-4c4a-82c8-207b4a936aa6

	/// ADDED 2026-11-12 (Fabric app): (hours - plan) / plan for the person; +100% with hours but no plan; blank with neither.
	measure 'Hours vs Plan Variance % by Person_app' =
			VAR _hours = [Synerion Hours_app]
			VAR _plan = [Planned Hours by Person_app]
			RETURN IF ( NOT ISBLANK ( _plan ) && _plan <> 0, DIVIDE ( _hours - _plan, _plan ), IF ( _hours > 0, 1 ) )
		formatString: +0%;-0%;0%
		displayFolder: _app\Projects
		lineageTag: c697f3b3-807c-4f5d-beb6-9cd1c063a271

	/// ADDED 2026-11-12 (Fabric app): Plan (Backlog) hours not assigned to a person: planned at role level or without resource. Group by fact_revenue_metrics[resource_role].
	measure 'Planned Hours Unassigned_app' = CALCULATE ( [Planned Hours_app], KEEPFILTERS ( fact_revenue_metrics[resource_match] IN { "role", "no_resource" } ) )
		formatString: #,0
		displayFolder: _app\Projects
		lineageTag: 2f4fb9fd-6d53-4677-9b26-25e586038cc8

	column Column
		isHidden
		formatString: 0
		lineageTag: 1d0a7c1a-f024-48fb-b562-4d3606e84c69
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
