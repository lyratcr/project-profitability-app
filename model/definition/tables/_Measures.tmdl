	measure 'Total Revenue (Master Hierarchy)' = ```
			
			// 1. Check if the visual is using the master organization hierarchy
			IF(
			    ISFILTERED('dim_Hierarchy_Master'[L1]) || ISFILTERED('dim_Hierarchy_Master'[L2]) || ISFILTERED('dim_Hierarchy_Master'[L3]),
			    
			    // 2. TRUE BRANCH: Calculate Actual Revenue using virtual relationships (TREATAS)
			    CALCULATE(
			        SUM('fact_revenue_metrics'[actual_revenue_usd]),
			        'fact_revenue_metrics'[scenario] = "Actual", // <--- THE FIX: Ignore Backlog
			        TREATAS(
			            SUMMARIZE('dim_Hierarchy_Master', 'dim_Hierarchy_Master'[L1], 'dim_Hierarchy_Master'[L2], 'dim_Hierarchy_Master'[L3]),
			            'fact_revenue_metrics'[financial_L1],
			            'fact_revenue_metrics'[financial_L2],
			            'fact_revenue_metrics'[financial_L3]
			        )
			    ),
			    
			    // 3. FALSE BRANCH: Standard sum if no hierarchy is filtered
			    CALCULATE(
			        SUM('fact_revenue_metrics'[actual_revenue_usd]),
			        'fact_revenue_metrics'[scenario] = "Actual" 
			    )
			)
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Revenue
		lineageTag: bfff428d-2c6d-4f2a-9451-21faab87dabc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Hours MoM %' = ```
			
			
			VAR _CM = [Total Worked Hours]
			VAR _LM = 
			    CALCULATE(
			        [Total Worked Hours], 
			        DATEADD('dim_calendar'[date], -1, MONTH)
			    )
			VAR _perc = DIVIDE(_CM - _LM, _LM)
			VAR _percformat = FORMAT(_perc, "+0.0%;-0.0%;0.0%" )
			
			RETURN
			
			IF(
			    _perc > 0,
			    UNICHAR(129157) & " " & _percformat,
			    UNICHAR(129158) & " " & _percformat
			)
			```
		displayFolder: Worked Hours
		lineageTag: 26ed758b-6991-49f5-9a90-0934af3a0e57

