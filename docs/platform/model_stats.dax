// 1) row counts
EVALUATE UNION(
  ROW("table", "Analysis Type", "rows", COUNTROWS('Analysis Type')),
  ROW("table", "app_user_profile_app", "rows", COUNTROWS('app_user_profile_app')),
  ROW("table", "dim_calendar", "rows", COUNTROWS('dim_calendar')),
  ROW("table", "dim_employee", "rows", COUNTROWS('dim_employee')),
  ROW("table", "dim_employee_history", "rows", COUNTROWS('dim_employee_history')),
  ROW("table", "dim_hierarchy_master", "rows", COUNTROWS('dim_hierarchy_master')),
  ROW("table", "dim_organization", "rows", COUNTROWS('dim_organization')),
  ROW("table", "dim_project", "rows", COUNTROWS('dim_project')),
  ROW("table", "fact_profitability_metrics", "rows", COUNTROWS('fact_profitability_metrics')),
  ROW("table", "fact_revenue_metrics", "rows", COUNTROWS('fact_revenue_metrics')),
  ROW("table", "info_gold_profitability_refresh", "rows", COUNTROWS('info_gold_profitability_refresh')),
  ROW("table", "security_project_access_app", "rows", COUNTROWS('security_project_access_app'))
)

// 2) column statistics (run as a separate query)
