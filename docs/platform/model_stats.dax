  ROW("table", "app_user_profile_app", "column", "user_upn", "distinct", DISTINCTCOUNT('app_user_profile_app'[user_upn]), "blank", COUNTBLANK('app_user_profile_app'[user_upn]), "min", "", "max", ""),
