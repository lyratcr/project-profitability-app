// P6 weekly trend: Synerion hours (bars) vs plan hours (line) by Sunday-Saturday week (dim_calendar[start_of_week_sun],
// never year_week: open item #22). The app sends the 12-week window; the last week may be the current one, to date.
EVALUATE
ADDCOLUMNS (
    SUMMARIZECOLUMNS (
        dim_calendar[start_of_week_sun],
        /* @filters */
        "Hours", [Synerion Hours_app],
        "PlannedHours", [Planned Hours_app]
    ),
    "Week", FORMAT ( dim_calendar[start_of_week_sun], "m/d" ),
    "WeekKey", VALUE ( FORMAT ( dim_calendar[start_of_week_sun], "yyyymmdd" ) )
)
ORDER BY dim_calendar[start_of_week_sun]
