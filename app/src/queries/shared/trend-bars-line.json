{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "description": "Trend with two measures: bars (left axis) and a line (right axis). Fields are set by trendSpec().",
    "encoding": {
        "x": { "field": "__x", "type": "ordinal", "title": null, "sort": { "field": "__xSort", "order": "ascending" } }
    },
    "layer": [
        {
            "layer": [{ "mark": "bar", "encoding": { "y": { "field": "__y", "type": "quantitative" } } }]
        },
        {
            "layer": [{ "mark": "line", "encoding": { "y": { "field": "__line", "type": "quantitative", "axis": { "orient": "right" } } } }]
        }
    ],
    "resolve": { "scale": { "y": "independent" } }
}
