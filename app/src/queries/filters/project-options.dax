// Filter options: project keys in either fact, with the name from the hours fact (blank for revenue-only projects).
// Until open item #1 is fixed, project filters go to the fact project_key columns instead of dim_project.
// The org markers take the selected L1 > L2 > L3 as the project's org (hours: project_L*, revenue: financial_L*);
// the customer markers take the selected customer (hours: project_customer, revenue: financial_customer).
// So the list only shows the projects of that org and customer. Markers with nothing selected are removed.
DEFINE
    VAR _hours = CALCULATETABLE ( DISTINCT ( fact_profitability_metrics[project_key] ) /* @hours-org */ /* @hours-customer */ )
    VAR _revenue = CALCULATETABLE ( DISTINCT ( fact_revenue_metrics[project_key] ) /* @revenue-org */ /* @revenue-customer */ )
    VAR _keys = DISTINCT ( UNION ( _hours, _revenue ) )
EVALUATE
ADDCOLUMNS (
    FILTER ( _keys, NOT ISBLANK ( [project_key] ) && [project_key] <> "" ),
    "Project Name",
        CALCULATE (
            MAX ( fact_profitability_metrics[project_name] ),
            TREATAS ( { [project_key] }, fact_profitability_metrics[project_key] )
        )
)
ORDER BY [project_key]
