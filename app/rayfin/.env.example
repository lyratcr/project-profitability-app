# rayfin/.env — local only, never committed (holds the deployment's publishable key).
# The Rayfin CLI writes the real file (`npx rayfin up` / `npx rayfin dev`), and
# `npm run dev` / `npm run build` turn the RAYFIN_PUBLIC_* values into .env.local (VITE_*)
# through `rayfin env --framework vite`. This file only documents the keys.
#
# Connector ids are not here: they live in rayfin/rayfin.yml (connector `profitmodel`).

RAYFIN_PUBLIC_API_URL=
RAYFIN_PUBLIC_PUBLISHABLE_KEY=
RAYFIN_PUBLIC_ITEM_ID=
RAYFIN_PUBLIC_PORTAL_URL=https://app.fabric.microsoft.com/
RAYFIN_PUBLIC_FUNCTIONS_URL=
RAYFIN_PUBLIC_FRONTEND_PORT=5173
